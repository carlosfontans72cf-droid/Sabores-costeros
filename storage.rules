rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function esImagenValida() {
      return request.resource.contentType.matches('image/.*')
             && request.resource.size < 3 * 1024 * 1024; // 3 MB
    }

    // Las fotos se guardan bajo el uid del DUEÑO del restaurante
    // (no bajo el id del documento), porque Storage Rules no puede
    // consultar Firestore para verificar esa propiedad. Comparar
    // contra request.auth.uid es simple y no necesita ninguna
    // consulta externa.
    match /restaurantes/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && esImagenValida();
    }

    match /platos/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && esImagenValida();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
